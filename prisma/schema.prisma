datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  subscriptionTier     String        @default("FREE") // FREE, PRO, AGENCY
  subscriptionStatus   String        @default("inactive") // active, canceled, inactive
  analysesLimit        Int           @default(10)
  analysesUsed         Int           @default(0)
  resetDate            DateTime      @default(now())
  prospects            Prospect[]
  activities           ActivityLog[]
  researchReports      ResearchReports[]
  opportunityAnalyses  OpportunityAnalysis[]
  proposals            Proposals[]
  outreachMessages     OutreachMessages[]
  subscriptions        Subscriptions[]
}

model Prospect {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String
  websiteUrl          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // 1. Evidence-Based Audit Data (Stored as JSON arrays of objects)
  verifiedFacts       String   // Array of { fact, sourceUrl, confidence, status }
  aiInferences        String   // Array of { finding, evidence, reasoning, confidence, status }
  buyingSignals       String   // Array of { signal, sourceUrl, sourceText, dateDiscovered, status }
  recommendations     String   // Array of { serviceName, issue, impact, estimatedFee, estimatedValue, calculation, confidence, expectedOutcome, estimatedRoi, status, explanation, evidenceList, priority, priorityScore, calculationDetails }
  competitorGaps      String   @default("[]") // Array of { featureName, prospectStatus, competitorStatus, confidence }
  
  // 2. Metrics & Scores
  opportunityScore    Int
  buyingSignalScore   Int
  scoreExplanations   String   // JSON of { opportunityScore: { explanation, evidence, breakdown }, buyingSignalScore: { explanation, evidence, breakdown } }
  potentialRevenue    Int
  closingProbability  Int
  problemSeverity     String   // High, Medium, Low
  leadQuality         String   // Hot, Warm, Cold
  proposalStatus      String   @default("Ready") // Ready, Speculative

  // 3. Trust & Verification Metrics
  evidenceQuality      Int      @default(100)
  verificationPassRate Int      @default(100)
  findingReliability   Int      @default(100)
  factsVerifiedCount   Int      @default(0)
  claimsRejectedCount  Int      @default(0)
  lowConfidenceCount   Int      @default(0)
  suppressedRecsCount  Int      @default(0)
  opportunityRange     String   @default("")
  revenueAssumptions   String   @default("") // JSON string

  // 3b. Crawl Coverage & Diagnostics Metrics
  pagesDiscoveredCount Int      @default(1)
  pagesCrawledCount    Int      @default(1)
  crawlCoveragePercent Int      @default(100)
  crawlDurationMs      Int      @default(0)
  totalTextExtracted   Int      @default(0)
  crawledPagesData     String   @default("[]") // JSON of Array<{ url, title, category, depth, status, textLength }>
  crawlDiagnostics     String   @default("{}") // JSON of { pagesDiscovered, pagesCrawled, pagesSkipped, crawlDurationMs, textExtractedBytes, warningMessage }

  // 3c. Analysis Versioning & Change Detection
  analysisVersion      Int      @default(1)
  previousAnalysisId   String?
  changeSummary        String   @default("{}") // JSON string of change detection & explanation


  // 4. Proposal Builder
  executiveSummary    String
  expectedResults     String
  estimatedRoi        String
  thirtyDayPlan       String
  ninetyDayPlan       String
  pricingRecommendation String

  // 5. One-Click Deliverables (Outreach Center)
  coldEmail           String
  linkedInMessage     String
  discoveryScript     String
  followUpSequence    String
  meetingAgenda       String
  outreachCampaign    String   @default("{}")

  researchReports      ResearchReports[]
  opportunityAnalyses  OpportunityAnalysis[]
  proposals            Proposals[]
  outreachMessages     OutreachMessages[]
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "REGISTERED", "SUBSCRIBED", "ANALYZED_COMPANY"
  details   String
  createdAt DateTime @default(now())
}

model ResearchReports {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId      String?
  prospect        Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  url             String
  title           String    @default("")
  category        String    @default("Homepage")
  depth           Int       @default(0)
  crawledText     String    @default("")
  diagnostics     String    @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OpportunityAnalysis {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId         String?
  prospect           Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunityScore   Int       @default(0)
  buyingSignalScore  Int       @default(0)
  recommendations    String    @default("[]")
  competitorGaps     String    @default("[]")
  riskFactors        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Proposals {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId            String?
  prospect              Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  title                 String    @default("Growth Strategy & System Optimization Proposal")
  status                String    @default("Draft") // Draft, Ready, Sent, Accepted
  executiveSummary      String    @default("")
  scopeOfWork           String    @default("")
  pricing               String    @default("")
  roiEstimate           String    @default("")
  plan30Day             String    @default("")
  plan90Day             String    @default("")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model OutreachMessages {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospectId      String?
  prospect        Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  channel         String    @default("Email") // Email, LinkedIn
  recipient       String    @default("")
  subject         String?
  body            String    @default("")
  status          String    @default("Draft") // Draft, Scheduled, Sent, Failed
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Subscriptions {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String    @default("")
  stripeSubscriptionId String    @default("")
  tier                 String    @default("FREE")
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

