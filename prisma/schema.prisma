datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  subscriptionTier     String        @default("FREE") // FREE, PRO, AGENCY
  subscriptionStatus   String        @default("inactive") // active, canceled, inactive
  analysesLimit        Int           @default(10)
  analysesUsed         Int           @default(0)
  resetDate            DateTime      @default(now())
  prospects            Prospect[]
  activities           ActivityLog[]
}

model Prospect {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String
  websiteUrl          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // 1. Audit & Solutions (What is wrong? What can I sell?)
  problem             String   // Detailed text
  opportunity         String   // Detailed text
  proposedSolution    String   // Detailed text
  servicesSuggested   String   // JSON string of array: { name, issue, estimatedFee, confidence }
  
  // 2. Metrics & Revenue Estimator
  potentialRevenue    Int      // Total estimated contract value (e.g. 4700)
  closingProbability  Int      // 0 to 100 percentage
  problemSeverity     String   // High, Medium, Low
  leadQuality         String   // Hot, Warm, Cold
  proposalStatus      String   @default("Ready") // Ready, Draft

  // 3. Proposal Builder
  executiveSummary    String   // Detailed executive summary
  expectedResults     String   // Detailed expected results
  estimatedRoi        String   // Estimated return on investment
  thirtyDayPlan       String   // 30 Day Plan checklist/timeline
  ninetyDayPlan       String   // 90 Day Plan timeline
  pricingRecommendation String // Suggested billing models & packages

  // 4. One-Click Deliverables (Outreach Center)
  coldEmail           String   // Cold email pitch
  linkedInMessage     String   // LinkedIn message (under 300 chars)
  discoveryScript     String   // Discovery call script
  followUpSequence    String   // JSON string or text block of email follow-ups
  meetingAgenda       String   // Meeting agenda for first call
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "REGISTERED", "SUBSCRIBED", "ANALYZED_COMPANY"
  details   String
  createdAt DateTime @default(now())
}
