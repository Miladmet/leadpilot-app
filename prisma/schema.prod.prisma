datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  subscriptionTier     String        @default("FREE") // FREE, PRO, AGENCY
  subscriptionStatus   String        @default("inactive") // active, canceled, inactive
  analysesLimit        Int           @default(10)
  analysesUsed         Int           @default(0)
  resetDate            DateTime      @default(now())
  prospects            Prospect[]
  activities           ActivityLog[]
}

model Prospect {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String
  websiteUrl          String
  summary             String
  painPoints          String   // JSON string of array
  opportunityScore    Int
  buyingSignalScore   Int
  coldEmail           String
  linkedInMessage     String
  salesAngle          String
  cta                 String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "REGISTERED", "SUBSCRIBED", "ANALYZED_COMPANY"
  details   String
  createdAt DateTime @default(now())
}
