datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String        @id @default(uuid())
  email                String        @unique
  passwordHash         String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  subscriptionTier     String        @default("FREE") // FREE, PRO, AGENCY
  subscriptionStatus   String        @default("inactive") // active, canceled, inactive
  analysesLimit        Int           @default(10)
  analysesUsed         Int           @default(0)
  resetDate            DateTime      @default(now())
  prospects            Prospect[]
  activities           ActivityLog[]
}

model Prospect {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String
  websiteUrl          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // 1. Evidence-Based Audit Data (Stored as JSON arrays of objects)
  verifiedFacts       String   // Array of { fact, sourceUrl, evidenceText }
  aiInferences        String   // Array of { inference, supportedByFacts: string[], confidence }
  buyingSignals       String   // Array of { signal, sourceUrl, sourceText, dateDiscovered }
  recommendations     String   // Array of { serviceName, issue, estimatedFee, confidence, explanation, evidenceList: string[] }
  
  // 2. Metrics & Scores
  opportunityScore    Int
  buyingSignalScore   Int
  scoreExplanations   String   // JSON of { opportunityScore: { explanation, evidence: string[] }, buyingSignalScore: { explanation, evidence: string[] } }
  potentialRevenue    Int
  closingProbability  Int
  problemSeverity     String   // High, Medium, Low
  leadQuality         String   // Hot, Warm, Cold
  proposalStatus      String   @default("Ready")

  // 3. Proposal Builder
  executiveSummary    String
  expectedResults     String
  estimatedRoi        String
  thirtyDayPlan       String
  ninetyDayPlan       String
  pricingRecommendation String

  // 4. One-Click Deliverables (Outreach Center)
  coldEmail           String
  linkedInMessage     String
  discoveryScript     String
  followUpSequence    String
  meetingAgenda       String
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g. "REGISTERED", "SUBSCRIBED", "ANALYZED_COMPANY"
  details   String
  createdAt DateTime @default(now())
}
