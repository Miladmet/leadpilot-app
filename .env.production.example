# =========================================================================
# LEADPILOT AI - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================

# 1. Database Configuration (Use a pooled PostgreSQL database on Vercel/Supabase)
# Append pgbouncer=true to support high concurrent client analyses.
DATABASE_URL="postgres://username:password@hostname:5432/databasename?pgbouncer=true"

# 2. Authentication Parameters
# Generate a strong 32-character security secret (e.g. openssl rand -base64 32)
JWT_SECRET="YOUR_STRONG_PRODUCTION_JWT_SECRET_KEY"

# 3. Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY="YOUR_LIVE_PRODUCTION_GEMINI_API_KEY"

# 4. Stripe Production Keys
# Set to actual Stripe production keys (e.g. sk_live_...) to process real payments
STRIPE_SECRET_KEY="sk_live_yourStripeSecretKey"
STRIPE_WEBHOOK_SECRET="whsec_yourStripeWebhookSigningSecret"

# 5. Stripe Product Price IDs (Obtain these from your Stripe Dashboard products menu)
STRIPE_PRICE_PRO="price_live_yourProMonthlyPriceId"
STRIPE_PRICE_AGENCY="price_live_yourAgencyPriceId"

# 6. CRM Integration
# Webhook URL to push qualified prospect deals (e.g. Zapier hook, HubSpot Custom CRM sync)
CRM_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/your_webhook_id"

# 7. Outbound Pitch SMTP Server Parameters
# Used by Nodemailer to send cold proposal emails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="sales@yourdomain.com"
SMTP_PASS="YOUR_SMTP_APPLICATION_PASSWORD"
SMTP_SECURE="false"

# 8. Scraper rotating proxy bypass (Optional - used to bypass bot checkers)
# Supports 'scrapingbee', 'zenrows', or 'scraperapi'
SCRAPING_PROXY_SERVICE="scrapingbee"
SCRAPING_PROXY_API_KEY="YOUR_SCRAPING_PROXY_API_KEY"
